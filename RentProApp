    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Navigation Tab Switcher Function
        function switchTab(tabId) {
            // Hide all tab contents
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(el => el.classList.remove('active'));

            // Reset navigation styles
            const navButtons = document.querySelectorAll('nav button');
            navButtons.forEach(btn => {
                btn.classList.remove('text-amber-400', 'bg-amber-500/10', 'font-semibold');
                btn.classList.add('text-slate-400');
            });

            // Activate target tab content
            const targetTab = document.getElementById('tab-' + tabId);
            if (targetTab) {
                targetTab.classList.add('active');
            }

            // Highlight active navigation button
            const activeNav = document.getElementById('nav-' + tabId);
            if (activeNav) {
                activeNav.classList.remove('text-slate-400');
                activeNav.classList.add('text-amber-400', 'bg-amber-500/10', 'font-semibold');
            }

            // Update Breadcrumb Header
            const breadcrumb = document.getElementById('breadcrumb-title');
            const titles = {
                'dashboard': 'Dashboard KPI Utama',
                'equipment': 'Master Data Alat Berat (Fleet Management)',
                'contracts': 'Manajemen Kontrak Rental Alat Berat',
                'hm': 'Monitoring Hour Meter (HM) Harian',
                'workshop': 'Work Order & Maintenance Workshop',
                'accounting': 'Akuntansi Accrual & Jurnal Double-Entry',
                'guide': 'Panduan GitHub & Supabase Integration'
            };
            if (breadcrumb && titles[tabId]) {
                breadcrumb.textContent = titles[tabId];
            }
        }

        // Real-Time Hour Meter Calculation Logic
        function calculateHM() {
            const hmAwal = 4250;
            const hmAkhirInput = document.getElementById('hm-akhir-input');
            const hmResult = document.getElementById('hm-aktual-result');

            let hmAkhir = parseFloat(hmAkhirInput.value) || 0;

            if (hmAkhir < hmAwal) {
                hmResult.textContent = 'ERROR: HM Mundur!';
                hmResult.className = 'w-full bg-rose-950 border border-rose-800 rounded px-3 py-2 text-xs font-bold text-rose-400';
            } else {
                const diff = (hmAkhir - hmAwal).toFixed(1);
                hmResult.textContent = `${diff} Jam`;
                hmResult.className = 'w-full bg-slate-950 border border-slate-800 rounded px-3 py-2 text-xs font-bold text-amber-400';
            }
        }
    </script>
